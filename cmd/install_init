#!/bin/bash
# 安装前检查：需要 python3 运行环境；docker 用于跑小爱桥接容器（缺失只告警，不阻断）

if ! command -v python3 >/dev/null 2>&1 && [ ! -x /usr/bin/python3 ]; then
    echo "未找到 python3，无法安装。" > "${TRIM_TEMP_LOGFILE}"
    exit 1
fi

if ! command -v docker >/dev/null 2>&1; then
    echo "提示：未检测到 docker，安装后控制台可用，但小爱桥接（8790）不会启动。" > "${TRIM_TEMP_LOGFILE}"
fi

exit 0
